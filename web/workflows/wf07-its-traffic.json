    {
      "id": "node-log",
      "name": "수집 로그 기록",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [1440, 300],
      "credentials": {
        "postgres": {
          "id": "DGfAkyb6sq7y5AJ2",
          "name": "Postgres Direct (5433)"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO traffic_fetch_log (api_type, status, record_count, fetched_at) VALUES ('traffic', 'success', 0, NOW()), ('incident', 'success', 0, NOW())",
        "options": {}
      },
      "continueOnFail": true
    },
    {
      "id": "node-cleanup",
      "name": "24시간 이전 데이터 삭제",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [1440, 500],
      "credentials": {
        "postgres": {
          "id": "DGfAkyb6sq7y5AJ2",
          "name": "Postgres Direct (5433)"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "DELETE FROM traffic_flow WHERE fetched_at < NOW() - INTERVAL '24 hours'; DELETE FROM traffic_fetch_log WHERE fetched_at < NOW() - INTERVAL '7 days';",
        "options": {}
      },
      "continueOnFail": true
    }
  ],
